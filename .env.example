# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/global-city-auth?appName=Cluster0

# JSON Web Token Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# OpenWeather API Key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# GeoDB Cities API on RapidAPI (https://rapidapi.com/wirefreethought/api/geodb-cities)
GEODB_API_KEY=your_rapidapi_geodb_key_here
GEODB_API_HOST=wft-geo-db.p.rapidapi.com

# Exchange Rate API (https://www.exchangerate-api.com/)
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here
